# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.db
# WAL sidecars; they sit beside the database and are not covered by *.db
*.db-wal
*.db-shm

# agent workspace (local; holds the user's installed skills)
/.ai-workspace

# the sites the user signed in to (local; sessions that sign in as them)
/.sign-ins
# editor agent tooling, not the app's
# Skills live in /.agents/skills, where any agent that reads Agent Skills finds
# them. Outside skills are installed per machine from skills-lock.json
# (`npx skills experimental_install`), so only the three written for this repo
# are committed there. Claude Code reads /.claude/skills instead: a link for each
# shared skill is committed, and resolves once the install has run.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/verify/
!/.agents/skills/cleanup/
!/.agents/skills/checkup/
/.claude/skills/*
!/.claude/skills/verify
!/.claude/skills/cleanup
!/.claude/skills/checkup
!/.claude/skills/grilling
!/.claude/skills/next-dev-loop
!/.claude/skills/agent-browser
!/.claude/skills/ai-sdk
!/.claude/skills/shadcn
/.claude/worktrees/
.playwright-cli
.playwright
.parcel-cache
.design
# Anything a contributor keeps to themselves. This is the one naming rule the
# repo has: a scratch note, a to-do list, a local override — name it *.local.*
# and it can never be committed by accident (CLAUDE.md says the same).
*.local.*

# the publish tree (scripts/pack.mts)
/dist

# Shell redirects that landed as empty files at the root
/next
/thursday@*
.vscode
