{
  "name": "thursday-agent",
  "version": "0.1.1",
  "description": "A voice agent that runs on your own machine — talk to her, she hands the slow work to bots with a shell, a browser and skills.",
  "license": "MIT",
  "keywords": [
    "voice-agent",
    "realtime",
    "speech",
    "ai-agent",
    "agent-skills",
    "local-first",
    "mcp",
    "openai-realtime",
    "assistant",
    "nextjs"
  ],
  "homepage": "https://github.com/cgoinglove/thursday#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgoinglove/thursday.git"
  },
  "bugs": {
    "url": "https://github.com/cgoinglove/thursday/issues"
  },
  "bin": {
    "thursday": "bin/thursday.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node bin/thursday.mjs",
    "lint": "biome check",
    "format": "biome format --write",
    "reset": "node scripts/reset.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "pack:check": "node scripts/pack.mts --no-build",
    "prepublishOnly": "node scripts/pack.mts --refuse-root",
    "release": "node scripts/pack.mts && npm publish dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/mcp": "^2.0.45",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/xai": "^4.0.54",
    "@base-ui/react": "^1.8.0",
    "@libsql/client": "^0.18.0",
    "@playwright/cli": "^0.1.19",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^7.0.93",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.42.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "^2.6.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "1.0.0-rc.4",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.15.1",
  "publishConfig": {
    "access": "public"
  }
}
