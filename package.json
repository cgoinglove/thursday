{
  "name": "thursday-agent",
  "version": "0.17.2",
  "description": "A voice agent that runs on your own machine — talk to her, she hands the slow work to bots with a shell, a browser and skills.",
  "license": "MIT",
  "keywords": [
    "voice-agent",
    "realtime",
    "speech",
    "ai-agent",
    "agent-skills",
    "local-first",
    "mcp",
    "openai-live",
    "assistant",
    "nextjs"
  ],
  "homepage": "https://github.com/cgoinglove/thursday#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgoinglove/thursday.git"
  },
  "bugs": {
    "url": "https://github.com/cgoinglove/thursday/issues"
  },
  "bin": {
    "thursday": "bin/thursday.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev.mts",
    "build": "next build",
    "start": "node bin/thursday.mjs",
    "lint": "biome check && node scripts/maps.mts",
    "knip": "knip",
    "test:live": "node --experimental-test-module-mocks --import tsx --test scripts/live-session.test.mts scripts/live-history.test.mts",
    "test:bot": "node --experimental-test-module-mocks --import tsx --test scripts/bot-context.test.mts",
    "test:memory": "node --import tsx --test scripts/memory-tools.test.mts",
    "test:reach": "node --experimental-test-module-mocks --import tsx --test scripts/reach.test.mts scripts/reach-channels.test.mts scripts/text-call.test.mts",
    "test:artifact": "node --import tsx --test scripts/artifact-paths.test.mts scripts/proxy.test.mts",
    "test:skills": "node --import tsx --test scripts/skill-files.test.mts scripts/page-edits.test.mts scripts/deck.test.mts scripts/sheet.test.mts",
    "format": "biome format --write",
    "reset": "node scripts/reset.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "pack:check": "node scripts/pack.mts --no-build",
    "prepublishOnly": "node scripts/pack.mts --refuse-root",
    "release": "node scripts/pack.mts && npm publish dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.62",
    "@ai-sdk/cerebras": "^3.0.55",
    "@ai-sdk/cohere": "^4.0.48",
    "@ai-sdk/deepinfra": "^3.0.55",
    "@ai-sdk/deepseek": "^3.0.52",
    "@ai-sdk/fireworks": "^3.0.58",
    "@ai-sdk/google": "^4.0.79",
    "@ai-sdk/groq": "^4.0.48",
    "@ai-sdk/mcp": "^2.0.57",
    "@ai-sdk/mistral": "^4.0.50",
    "@ai-sdk/openai": "^4.0.74",
    "@ai-sdk/react": "4.0.109",
    "@ai-sdk/togetherai": "^3.0.56",
    "@ai-sdk/xai": "^5.0.7",
    "@base-ui/react": "^1.8.0",
    "@libsql/client": "^0.18.0",
    "@playwright/cli": "0.1.21",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "ai": "^7.0.113",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.48.0",
    "marked": "^17.0.6",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "^2.6.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "1.0.0-rc.4",
    "knip": "^6.38.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.15.1",
  "publishConfig": {
    "access": "public"
  }
}
